DATABASE_URL=postgresql://agent:agent@localhost:55432/agent_memory

# Chat/completion models go through the proxy endpoint.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://code28.ccwu.cc/v1
OPENAI_MODEL=gpt-5.5

# Embedding models can use a different OpenAI-compatible endpoint.
OPENAI_EMBEDDING_API_KEY=
OPENAI_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_EMBEDDING_MODEL=qwen3.7-text-embedding
OPENAI_EMBEDDING_DIMENSIONS=1536

# Built-in web search uses SearXNG. Leave SEARXNG_BASE_URL empty to disable it.
WEB_SEARCH_PROVIDER=searxng
SEARXNG_BASE_URL=http://localhost:8080
WEB_SEARCH_MAX_RESULTS=5

# Optional external MCP servers, passed to langchain-mcp-adapters MultiServerMCPClient.
MCP_SERVERS_JSON={}

# Local runtime/cache storage.
STORAGE_DIR=D:/Project/Agent/Agent/runtime

# Social media parser performance and cache settings.
MEDIA_CACHE_TTL_SECONDS=86400
MEDIA_REQUEST_TIMEOUT_SECONDS=8
MEDIA_PARSE_CONCURRENCY_LIMIT=5
MEDIA_DOUYIN_PARSE_CONCURRENCY_LIMIT=5
MEDIA_XHS_PARSE_CONCURRENCY_LIMIT=5
MEDIA_KUAISHOU_PARSE_CONCURRENCY_LIMIT=5

# Media preview/download settings.
MEDIA_DOWNLOAD_TIMEOUT_SECONDS=120
MEDIA_MAX_DOWNLOAD_MB=500
MEDIA_PREVIEW_TRANSCODE_ENABLED=true
MEDIA_FFMPEG_PATH=ffmpeg
MEDIA_PARSE_LOCK_TTL_SECONDS=30
MEDIA_PREVIEW_LOCK_TTL_SECONDS=300
MEDIA_PREVIEW_CONCURRENCY_LIMIT=5
MEDIA_PREVIEW_CACHE_TTL_SECONDS=86400
MEDIA_PREVIEW_CACHE_MAX_MB=2048

# Cookie pool for Douyin/Xiaohongshu/Kuaishou. Leave empty if not using cookies.
MEDIA_COOKIE_POOL_PATH=D:/Project/Agent/Agent/cookie_manager/cookies.json
MEDIA_COOKIE_FAILURE_COOLDOWN_SECONDS=300
MEDIA_DOUYIN_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/152.0.0.0 Safari/537.36
MEDIA_XHS_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/152.0.0.0 Safari/537.36
MEDIA_KUAISHOU_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/152.0.0.0 Safari/537.36
